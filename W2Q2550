class Solution {
    public int monkeyMove(int n) {
        long res = 1, base = 2, mod = 1_000_000_007;
        while (n > 0) {
            if ((n & 1) == 1) res = (res * base) % mod;
            base = (base * base) % mod;
            n >>= 1;
        }
        return (int) ((res - 2 + mod) % mod);
    }
}
