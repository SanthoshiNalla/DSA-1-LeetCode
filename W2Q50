class Solution {
    public double myPow(double x, int n) {
        long exp = n; // Prevents overflow when n == Integer.MIN_VALUE (-2^31)
        if (exp < 0) {
            x = 1.0 / x;
            exp = -exp;
        }

        double result = 1.0;
        while (exp > 0) {
            // If current lowest bit of exp is 1, multiply current base into result
            if ((exp & 1L) == 1L) {
                result *= x;
            }
            // Square the base and halve the exponent
            x *= x;
            exp >>= 1;
        }

        return result;
    }
}
